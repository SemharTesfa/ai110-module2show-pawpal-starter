
classDiagram
    class Pet {
        +str name
        +str species
        +int age
        +list tasks
        +get_info()
        +add_task(task)
    }

    class Task {
        +str title
        +int duration
        +str priority
        +Pet pet
        +str frequency
    
        +bool completed
        +str time
        +str due_date
        +get_details()
        +mark_complete()
    }

    class Owner {
        +str name
        +int available_minutes
        +list pets
        +list preferences
        +add_pet(pet)
        +get_all_tasks()
    }

    class PawPalSystem {
        +Owner owner
        +add_task(task)
        +sort_tasks()
        +find_conflicts()
        +sort_by_time()
        +filter_tasks(pet_name, completed)
        +generate_plan()
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Task --> Pet : assigned to
    PawPalSystem --> Owner : schedules for
